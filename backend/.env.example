# Optional - the app runs fully without a key using deterministic fallbacks
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Set to 0 to skip loading sentence-transformers (uses difflib fallback)
USE_EMBEDDINGS=1
# One-click demo company logins on the login page (set 0 in production)
DEMO_LOGIN=1
# Photo recognition with CLIP (one-time ~600 MB download, loaded in the background). 0 = colour/texture descriptor only
USE_CLIP=1

# Email alerts (optional). Leave SMTP_HOST empty to write emails to backend/outbox/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sylithex <alerts@example.com>
APP_URL=http://localhost:5173
